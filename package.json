{
  "name": "wms-backend",
  "version": "1.0.1",
  "description": "Warehouse Management System Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm --filter frontend dev\" --names \"backend,frontend\" --prefix-colors \"blue,green\"",
    "dev:ui": "concurrently \"pnpm server:dev\" \"pnpm --filter frontend dev\" --names \"backend,frontend\" --prefix-colors \"blue,green\"",
    "build": "pnpm build:frontend && pnpm build:backend",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "tsc",
    "start": "node dist/index.js",
    "server": "node server.js",
    "server:dev": "nodemon server.js",
    "server:with-ui": "pnpm build:frontend && node server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "db:deploy": "prisma migrate deploy",
    "queue:processor": "ts-node src/services/queueProcessor.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [
    "wms",
    "warehouse",
    "management",
    "backend",
    "supabase"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@prisma/client": "^5.7.1",
    "@supabase/supabase-js": "^2.38.4",
    "@types/dotenv": "^8.2.3",
    "@types/nodemailer": "^7.0.4",
    "antd": "^5.29.3",
    "axios": "^1.6.7",
    "bull": "^4.12.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.3.0",
    "googleapis": "^158.0.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "pnpm": "^10.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.10.1",
    "redis": "^4.7.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
