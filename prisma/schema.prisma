model normalization_tags {
  id               Int       @id @default(autoincrement())
  category         String    @db.VarChar(50)
  input_value      String    @db.VarChar(255)
  normalized_value String    @db.VarChar(255)
  tags             String[]
  is_postfix       Boolean?  @default(false)
  is_active        Boolean?  @default(true)
  priority         Int?      @default(0)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)

  @@index([category], map: "idx_normalization_tags_category")
  @@index([input_value], map: "idx_normalization_tags_input")
  @@index([tags], map: "idx_normalization_tags_tags", type: Gin)
}

