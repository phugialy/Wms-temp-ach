// Cron Job Execution Tracking
model CronJobExecution {
  id              BigInt    @id @default(autoincrement())
  workflowType    String    @map("workflow_type") @db.VarChar(50) // 'bulk-add', etc.
  triggerSource   String    @map("trigger_source") @db.VarChar(50) // 'vercel-cron', 'manual', 'api', 'scheduled-cron'
  status          String    @default("pending") @db.VarChar(20) // 'pending', 'running', 'completed', 'failed'
  
  // Schedule reference (if triggered by a schedule)
  scheduleId      BigInt?   @map("schedule_id") // Reference to CronJobSchedule
  schedule        CronJobSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  
  // Workflow parameters
  stations        String[]  // Array of station names
  dateFrom        DateTime? @map("date_from") @db.Date
  dateTo          DateTime? @map("date_to") @db.Date
  location        String?   @db.VarChar(100)
  
  // Execution tracking
  startedAt       DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  durationMs      Int?      @map("duration_ms")
  
  // Results
  devicesFound    Int       @default(0) @map("devices_found")
  devicesProcessed Int      @default(0) @map("devices_processed")
  devicesAdded    Int       @default(0) @map("devices_added")
  devicesFailed   Int       @default(0) @map("devices_failed")
  
  // Error tracking
  errorMessage    String?   @map("error_message") @db.Text
  errorDetails    Json?     @map("error_details")
  
  // Metadata
  metadata        Json?     // Additional workflow-specific data
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([workflowType], map: "idx_cron_job_workflow_type")
  @@index([status], map: "idx_cron_job_status")
  @@index([triggerSource], map: "idx_cron_job_trigger_source")
  @@index([startedAt], map: "idx_cron_job_started_at")
  @@index([completedAt], map: "idx_cron_job_completed_at")
  @@index([dateFrom, dateTo], map: "idx_cron_job_date_range")
  @@index([scheduleId], map: "idx_cron_job_schedule_id")
  @@map("cron_job_execution")
}

// Cron Job Schedule Configuration
model CronJobSchedule {
  id              BigInt    @id @default(autoincrement())
  name            String    @db.VarChar(100) // User-friendly name for the schedule
  workflowType    String    @default("bulk-add") @map("workflow_type") @db.VarChar(50)
  
  // Workflow parameters (pre-set)
  stations        String[]  // Array of station names
  location        String    @db.VarChar(100)
  dateRangeDays   Int       @default(1) @map("date_range_days") // How many days back to process (e.g., 1 = yesterday)
  
  // Schedule configuration
  scheduleTime    String    @map("schedule_time") @db.VarChar(10) // HH:mm format (e.g., "02:00")
  timezone        String    @default("UTC") @db.VarChar(50)
  frequency       String    @map("frequency") @db.VarChar(20) // 'daily', 'weekly'
  weeklyDays      Int[]     @default([]) @map("weekly_days") // 0=Sunday, 1=Monday, ..., 6=Saturday
  cronExpression  String?   @map("cron_expression") @db.VarChar(100) // Generated cron expression
  
  // Status
  isActive        Boolean   @default(true) @map("is_active")
  
  // Email reporting configuration
  emailRecipients String[]  @default([]) @map("email_recipients") // List of email addresses to receive reports
  emailOnSuccess  Boolean   @default(true) @map("email_on_success") // Send email on successful runs
  emailOnFailure  Boolean   @default(true) @map("email_on_failure") // Send email on failed runs
  
  // Metadata
  description     String?   @db.Text
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz(6)
  nextRunAt      DateTime? @map("next_run_at") @db.Timestamptz(6)
  totalRuns      Int       @default(0) @map("total_runs")
  successfulRuns Int       @default(0) @map("successful_runs")
  failedRuns     Int       @default(0) @map("failed_runs")
  
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.VarChar(100)

  // Relations
  executions      CronJobExecution[]

  @@index([isActive], map: "idx_cron_schedule_active")
  @@index([frequency], map: "idx_cron_schedule_frequency")
  @@index([nextRunAt], map: "idx_cron_schedule_next_run")
  @@map("cron_job_schedule")
}

// Email Report Subscription
model EmailReportSubscription {
  id                BigInt    @id @default(autoincrement())
  name              String    @db.VarChar(100)
  description       String?   @db.Text
  
  // Which Cron Jobs to Monitor
  scheduleIds       BigInt[]  @default([]) @map("schedule_ids") // Empty array = all schedules
  locationFilter    String?   @map("location_filter") @db.VarChar(100)
  
  // Recipients (Array Format)
  emailRecipients   String[]  @default([]) @map("email_recipients")
  
  // Delivery Schedule
  deliveryMode      String    @default("immediate") @map("delivery_mode") @db.VarChar(20) // 'immediate' | 'scheduled'
  scheduleTime      DateTime? @map("schedule_time") @db.Time // When to send (for scheduled)
  scheduleFrequency String?   @map("schedule_frequency") @db.VarChar(20) // 'daily' | 'weekly' | 'monthly'
  scheduleDays      Int[]     @default([]) @map("schedule_days") // For weekly: [1,2,3] = Mon, Tue, Wed
  timezone          String    @default("UTC") @db.VarChar(50)
  
  // Email Preferences
  emailOnSuccess    Boolean   @default(true) @map("email_on_success")
  emailOnFailure    Boolean   @default(true) @map("email_on_failure")
  summaryOnly       Boolean   @default(false) @map("summary_only") // Only send summary, skip individual
  
  // Status
  isActive          Boolean   @default(true) @map("is_active")
  
  // Metadata
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?   @map("created_by") @db.VarChar(100)
  lastSentAt        DateTime? @map("last_sent_at") @db.Timestamptz(6)

  @@index([isActive, deliveryMode], map: "idx_email_subscription_active")
  @@index([deliveryMode, scheduleTime], map: "idx_email_subscription_scheduled_time")
  @@map("email_report_subscription")
}