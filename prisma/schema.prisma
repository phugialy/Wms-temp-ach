model bulk_operation_executions {
  id                         Int                          @id @default(autoincrement())
  scheduled_operation_id     Int?
  execution_started_at       DateTime?                    @default(now()) @db.Timestamp(6)
  execution_completed_at     DateTime?                    @db.Timestamp(6)
  execution_status           String?                      @default("RUNNING") @db.VarChar(20)
  total_devices_processed    Int?                         @default(0)
  devices_passed             Int?                         @default(0)
  devices_failed             Int?                         @default(0)
  devices_pending            Int?                         @default(0)
  devices_added_to_db        Int?                         @default(0)
  skus_added                 Int?                         @default(0)
  execution_duration_seconds Int?
  error_message              String?
  scheduled_bulk_operations  scheduled_bulk_operations?   @relation(fields: [scheduled_operation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bulk_operation_sku_results bulk_operation_sku_results[]
}

model bulk_operation_sku_results {
  id                        Int                        @id @default(autoincrement())
  execution_id              Int?
  sku_code                  String                     @db.VarChar(100)
  brand                     String?                    @db.VarChar(50)
  model                     String?                    @db.VarChar(100)
  capacity                  String?                    @db.VarChar(20)
  color                     String?                    @db.VarChar(30)
  carrier                   String?                    @db.VarChar(50)
  device_count              Int?                       @default(0)
  working_count             Int?                       @default(0)
  failed_count              Int?                       @default(0)
  bulk_operation_executions bulk_operation_executions? @relation(fields: [execution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model scheduled_bulk_operations {
  id                        Int                         @id @default(autoincrement())
  station_id                String                      @db.VarChar(50)
  location_inspection       String                      @db.VarChar(100)
  operation_type            String                      @default("BULK_ADD") @db.VarChar(50)
  schedule_date             DateTime                    @default(dbgenerated("CURRENT_DATE")) @db.Date
  schedule_time             DateTime                    @db.Time(6)
  schedule_type             String?                     @default("once") @db.VarChar(20)
  is_active                 Boolean?                    @default(true)
  is_modified               Boolean?                    @default(false)
  created_at                DateTime?                   @default(now()) @db.Timestamp(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamp(6)
  created_by                String?                     @db.VarChar(100)
  notes                     String?
  bulk_operation_executions bulk_operation_executions[]
}

model sku_brand_reference {
  id                  Int                   @id @default(autoincrement())
  brand_name          String                @db.VarChar(50)
  brand_code          String                @unique @db.VarChar(20)
  sku_patterns        String[]
