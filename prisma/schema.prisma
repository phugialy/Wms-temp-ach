generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model Item {
  imei             String    @id @db.VarChar(15)
  model            String?   @db.VarChar(100)
  modelNumber      String?   @map("model_number") @db.VarChar(100)
  carrier          String?   @db.VarChar(50)
  capacity         String?   @db.VarChar(50)
  color            String?   @db.VarChar(50)
  batteryHealth    String?   @map("battery_health") @db.VarChar(50)
  batteryCount     Int?      @map("battery_count")
  working          String?   @default("PENDING") @db.VarChar(20)
  location         String?   @default("Default Location") @db.VarChar(100)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  matched_sku      String?   @db.VarChar(255)
  sku_match_score  Decimal?  @db.Decimal(5, 2)
  sku_match_method String?   @db.VarChar(100)
  sku_match_status String?   @db.VarChar(50)
  sku_match_notes  String?
  sku_matched_at   DateTime? @db.Timestamptz(6)
  product          Product   @relation(fields: [imei], references: [imei], onDelete: Cascade, onUpdate: NoAction)

  @@index([capacity], map: "idx_item_capacity")
  @@index([carrier], map: "idx_item_carrier")
  @@index([color], map: "idx_item_color")
  @@index([model], map: "idx_item_model")
  @@index([working], map: "idx_item_working")
  @@index([matched_sku], map: "idx_item_matched_sku")
  @@index([sku_match_status], map: "idx_item_sku_match_status")
  @@index([sku_matched_at], map: "idx_item_sku_matched_at")
  @@map("item")
}

model Product {
  imei                 String                 @id @db.VarChar(15)
  dateIn               DateTime?              @default(now()) @map("date_in") @db.Timestamptz(6)
  sku                  String?                @db.VarChar(200)
  brand                String?                @db.VarChar(100)
  createdAt            DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  device_test          DeviceTest?
  item                 Item?
  location_transitions location_transitions[]
  movement_history     movement_history[]
  operator_actions     operator_actions[]
  sku_matching_queue   sku_matching_queue[]
  sku_matching_results SkuMatchingResults?

  @@index([brand], map: "idx_product_brand")
  @@index([dateIn], map: "idx_product_date_in")
  @@index([sku], map: "idx_product_sku")
  @@index([brand], map: "idx_sku_matching_view_brand")
  @@index([imei], map: "idx_sku_matching_view_imei")
  @@index([sku], map: "idx_sku_matching_view_sku")
  @@map("product")
}

model DeviceTest {
  id         BigInt    @id @default(autoincrement())
  imei       String?   @unique(map: "device_test_imei_unique") @db.VarChar(15)
  working    String?   @db.VarChar(20)
  defects    String?
  notes      String?
  custom1    String?
  test_date  DateTime? @default(now()) @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  tester     String?   @db.VarChar(255)
  product    Product?  @relation(fields: [imei], references: [imei], onDelete: Cascade, onUpdate: NoAction)

  @@index([test_date], map: "idx_device_test_date")
  @@index([imei], map: "idx_device_test_imei")
  @@map("device_test")
}

model DataQueue {
  id                   BigInt               @id @default(autoincrement())
  rawData              Json                 @map("raw_data")
  source               String               @db.VarChar(50)
  status               String?              @default("pending") @db.VarChar(20)
  priority             Int?                 @default(5)
  retryCount           Int?                 @default(0) @map("retry_count")
  maxRetries           Int?                 @default(3) @map("max_retries")
  errorMessage         String?              @map("error_message")
  batchId              String?              @map("batch_id") @db.VarChar(50)
  createdAt            DateTime?            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  processedAt          DateTime?            @map("processed_at") @db.Timestamptz(6)
  queue_processing_log QueueProcessingLog[]

  @@index([batchId], map: "idx_data_queue_batch_id")
  @@index([createdAt], map: "idx_data_queue_created_at")
  @@index([priority], map: "idx_data_queue_priority")
  @@index([status], map: "idx_data_queue_status")
  @@map("data_queue")
}

model QueueProcessingLog {
  id          BigInt     @id @default(autoincrement())
  queueItemId BigInt?    @map("queue_item_id")
  action      String?    @db.VarChar(50)
  message     String?
  error       String?
  createdAt   DateTime?  @default(now()) @map("created_at") @db.Timestamptz(6)
  data_queue  DataQueue? @relation(fields: [queueItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("queue_processing_log")
}

model SkuMaster {
  id              Int               @id @default(autoincrement())
  skuCode         String            @unique @map("sku_code") @db.VarChar(100)
  brand           String?           @db.VarChar(50)
  model           String?           @db.VarChar(100)
  capacity        String?           @db.VarChar(50)
  color           String?           @db.VarChar(50)
  carrier         String?           @db.VarChar(50)
  postFix         String?           @map("post_fix") @db.VarChar(50)
  is_unlocked     Boolean?          @default(false)
  is_active       Boolean?          @default(true)
  source_tab      String?           @db.VarChar(100)
  sheet_row_id    Int?
  last_synced     DateTime?         @default(now()) @db.Timestamp(6)
  createdAt       DateTime?         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  model_tag       String?           @db.VarChar(50)
  capacity_tag    String?           @db.VarChar(50)
  color_tag       String?           @db.VarChar(50)
  carrier_tag     String?           @db.VarChar(50)
  postfix_tag     String?           @db.VarChar(50)
  tagCount        Int?              @default(0) @map("tag_count")
  deviceType      String?           @map("device_type") @db.VarChar(20)
  skuTags         String[]          @map("sku_tags")
  sku_master_tags sku_master_tags[]

  @@index([is_active], map: "idx_sku_master_active")
  @@index([brand, model], map: "idx_sku_master_brand_model")
  @@index([carrier], map: "idx_sku_master_carrier")
  @@index([deviceType], map: "idx_sku_master_device_type")
  @@map("sku_master")
}

model SkuMatchingResults {
  id                Int       @id @default(autoincrement())
  imei              String    @unique @db.VarChar(15)
  original_sku      String    @db.VarChar(255)
  matched_sku       String?   @db.VarChar(255)
  matchScore        Decimal?  @map("match_score") @db.Decimal(5, 2)
  match_method      String?   @db.VarChar(50)
  match_status      String?   @default("pending") @db.VarChar(20)
  match_notes       String?
  processed_at      DateTime? @default(now()) @db.Timestamp(6)
  updatedAt         DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  requiresAttention Boolean?  @default(false) @map("requires_attention")
  product           Product   @relation(fields: [imei], references: [imei], onDelete: Cascade, onUpdate: NoAction)

  @@index([imei], map: "idx_sku_matching_results_imei")
  @@index([match_status], map: "idx_sku_matching_results_status")
  @@map("sku_matching_results")
}

model SkuSyncLog {
  id           Int       @id @default(autoincrement())
  syncType     String    @map("sync_type") @db.VarChar(50)
  status       String    @db.VarChar(50)
  total_skus   Int?      @default(0)
  new_skus     Int?      @default(0)
  updated_skus Int?      @default(0)
  failed_skus  Int?      @default(0)
  errorMessage String?   @map("error_message")
  startedAt    DateTime? @default(now()) @map("started_at") @db.Timestamp(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamp(6)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  skipped_skus Int?      @default(0)

  @@map("sku_sync_log")
}

model Inventory {
  id             BigInt    @id @default(autoincrement())
  sku            String    @db.VarChar(200)
  location       String    @db.VarChar(100)
  qty_total      Int?      @default(0)
  pass_devices   Int?      @default(0)
  failed_devices Int?      @default(0)
  reserved       Int?      @default(0)
  available      Int?      @default(0)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([sku, location])
  @@index([location], map: "idx_inventory_location")
  @@index([sku], map: "idx_inventory_sku")
  @@index([sku, location], map: "idx_inventory_sku_location")
  @@map("inventory")
}

model AbbreviationMappings {
  id           Int       @id @default(autoincrement())
  abbreviation String    @db.VarChar(50)
  full_value   String    @db.VarChar(100)
  category     String    @db.VarChar(20)
  is_active    Boolean?  @default(true)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)

  @@unique([abbreviation, category])
  @@map("abbreviation_mappings")
}

model ApiProcessingLogs {
  id                      Int       @id @default(autoincrement())
  batch_id                String    @db.VarChar(255)
  api_endpoint            String    @db.VarChar(100)
  request_source          String    @db.VarChar(50)
  items_count             Int
  chunks_count            Int
  status                  String    @db.VarChar(50)
  processing_triggered    Boolean?  @default(false)
  processing_started_at   DateTime? @db.Timestamptz(6)
  processing_completed_at DateTime? @db.Timestamptz(6)
  items_processed         Int?      @default(0)
  items_failed            Int?      @default(0)
  errorMessage            String?   @map("error_message")
  processing_duration_ms  Int?
  createdAt               DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at              DateTime? @default(now()) @db.Timestamptz(6)

  @@index([batch_id], map: "idx_api_logs_batch_id")
  @@index([createdAt], map: "idx_api_logs_created_at")
  @@index([processing_triggered], map: "idx_api_logs_processing_triggered")
  @@index([status], map: "idx_api_logs_status")
  @@map("api_processing_logs")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
