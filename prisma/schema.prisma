model queue_processing_requests {
  id           Int       @id @default(autoincrement())
  batch_id     String    @unique @db.VarChar(255)
  item_count   Int?      @default(1)
  status       String?   @default("pending") @db.VarChar(50)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
  processed_at DateTime? @db.Timestamptz(6)
}

model sku_mapping_rules {
  id               Int             @id @default(autoincrement())
  rule_name        String          @db.VarChar(100)
  brand_pattern    String?         @db.VarChar(100)
  model_pattern    String?         @db.VarChar(100)
  capacity_pattern String?         @db.VarChar(100)
  color_pattern    String?         @db.VarChar(100)
  carrier_pattern  String?         @db.VarChar(100)
  target_sku       String?         @db.VarChar(100)
  priority         Int?            @default(1)
  is_active        Boolean?        @default(true)
  created_at       DateTime?       @default(now()) @db.Timestamp(6)
  sku_match_log    sku_match_log[]

  @@index([is_active], map: "idx_sku_mapping_rules_active")
}

model sku_master_tags {
  id            Int        @id @default(autoincrement())
  sku_master_id Int?
  tag_id        Int?
  tag_position  Int
  tag_category  String     @db.VarChar(50)
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  sku_master    SkuMaster? @relation(fields: [sku_master_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sku_tags      sku_tags?  @relation(fields: [tag_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([sku_master_id, tag_id, tag_position])
}

model sku_match_log {
  id                Int                @id @default(autoincrement())
  imei              String             @db.VarChar(50)
  original_sku      String?            @db.VarChar(100)
  matched_sku       String?            @db.VarChar(100)
  match_score       Decimal?           @db.Decimal(5, 2)
  match_method      String?            @db.VarChar(50)
  applied_rule_id   Int?
  created_at        DateTime?          @default(now()) @db.Timestamp(6)
  sku_mapping_rules sku_mapping_rules? @relation(fields: [applied_rule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([imei], map: "idx_sku_match_log_imei")
}

