  @@index([created_at], map: "idx_location_transitions_created_at")
  @@index([imei], map: "idx_location_transitions_imei")
}

model movement_history {
  id                BigInt    @id @default(autoincrement())
  imei              String?   @db.VarChar(15)
  location_original String?   @db.VarChar(100)
  location_updated  String?   @db.VarChar(100)
  movement_date     DateTime? @default(now()) @db.Timestamptz(6)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  product           Product?  @relation(fields: [imei], references: [imei], onDelete: Cascade, onUpdate: NoAction)

  @@index([movement_date], map: "idx_movement_history_date")
  @@index([imei], map: "idx_movement_history_imei")
}

